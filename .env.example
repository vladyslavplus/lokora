# Copy to `.env` in the repository root (`.env` is gitignored).
# Do not commit real values.

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
LOKORA_OIDC_CLIENT_SECRET=

POSTGRES_DB=lokora
POSTGRES_USER=lokora
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lokora
SPRING_DATASOURCE_USERNAME=lokora
SPRING_DATASOURCE_PASSWORD=

LOKORA_OIDC_CLIENT_ID=lokora-app
LOKORA_ISSUER_URI=http://localhost:8180/realms/lokora
LOKORA_RESOURCE_SERVICE_URL=http://localhost:8081
LOKORA_RESERVATION_SERVICE_URL=http://localhost:8082

# Separate schemas share the existing PostgreSQL database. Liquibase creates them and copies existing rows.
RESOURCE_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lokora?currentSchema=resource_service&options=-c%20timezone=UTC
RESOURCE_DATASOURCE_USERNAME=lokora
RESOURCE_DATASOURCE_PASSWORD=
RESERVATION_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lokora?currentSchema=reservation_service&options=-c%20timezone=UTC
RESERVATION_DATASOURCE_USERNAME=lokora
RESERVATION_DATASOURCE_PASSWORD=
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lokora?currentSchema=notification_service&options=-c%20timezone=UTC
NOTIFICATION_DATASOURCE_USERNAME=lokora
NOTIFICATION_DATASOURCE_PASSWORD=

# Message broker. Defaults target a local IDE run; in Docker Compose RABBITMQ_HOST is the service name `rabbitmq`.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=lokora
RABBITMQ_PASSWORD=

# Optional local-only realm import (gitignored): copy lokora-realm.json, add client secret + users from lokora-local-users.json.example, save as lokora-realm.local.json, set LOKORA_KEYCLOAK_REALM_IMPORT in `.env`.
# Demo logins: employee / lokora-employee-dev, workspace-admin / lokora-admin-dev
