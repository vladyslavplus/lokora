# Copy to `.env` in the repository root (`.env` is gitignored).
# Do not commit real values.

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
LOKORA_OIDC_CLIENT_SECRET=

POSTGRES_DB=lokora
POSTGRES_USER=lokora
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lokora
SPRING_DATASOURCE_USERNAME=lokora
SPRING_DATASOURCE_PASSWORD=

LOKORA_OIDC_CLIENT_ID=lokora-app
LOKORA_ISSUER_URI=http://localhost:8180/realms/lokora

# Optional local-only realm import (gitignored): copy lokora-realm.json, add client secret + users from lokora-local-users.json.example, save as lokora-realm.local.json, set LOKORA_KEYCLOAK_REALM_IMPORT in `.env`.
# Demo logins: employee / lokora-employee-dev, workspace-admin / lokora-admin-dev
